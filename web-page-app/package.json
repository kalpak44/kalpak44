{
  "name": "web-page",
  "private": true,
  "version": "0.1.0",
  "description": "Personal web page built with Vite, React, and React Router.",
  "author": {
    "name": "Pavel Usanli"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vite",
    "react",
    "portfolio",
    "resume",
    "website"
  ],
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:resume": "RESUME_DATA_DIR=../cv-pdf-generator/data mvn -B -Dmaven.repo.local=../.mvn/repository -f ../cv-pdf-generator/pom.xml verify exec:java -Dexec.mainClass=online.pavelusanli.resume.ResumeApp -Dexec.args='build public/assets/resume.pdf'",
    "docker:build": "docker build -f docker/Dockerfile -t web-page-app ..",
    "dev:resume": "RESUME_DATA_DIR=../cv-pdf-generator/data mvn -Dmaven.repo.local=../.mvn/repository -f ../cv-pdf-generator/pom.xml exec:java -Dexec.mainClass=online.pavelusanli.resume.ResumeApp -Dexec.args='serve'",
    "preview": "vite preview --outDir build/client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "isbot": "^5"
  },
  "overrides": {
    "chevrotain": {
      "lodash-es": "^4.18.1"
    },
    "brace-expansion": "^5.0.12",
    "mermaid": {
      "katex": "^0.19.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
